# Copie para .env.local e preencha. NUNCA faça commit do .env.local.
# Variáveis com NEXT_PUBLIC_ vão para o navegador: nunca coloque segredos nelas.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
TRIAL_DAYS=3
# Segredo que o worker usa para pedir atualização das páginas (/api/revalidate). Mínimo 16 caracteres.
REVALIDATE_SECRET=

# --- Supabase (Project Settings > API Keys) ---
# Use as chaves novas (sb_publishable_... e sb_secret_...). As legadas anon/service_role estão sendo descontinuadas.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# sb_secret_...: somente servidor e worker. Ignora o RLS. Nunca no navegador.
SUPABASE_SECRET_KEY=

# --- Fontes de dados ---
# fixture = dados fictícios, sem rede (padrão). live = APIs reais.
DATA_PROVIDER_MODE=fixture
# API-NBA: crie a chave em dashboard.api-football.com (NÃO pelo RapidAPI, que cobra excedentes).
APISPORTS_KEY=
APISPORTS_DAILY_LIMIT=90
APISPORTS_PER_MINUTE=9
# balldontlie (opcional): app.balldontlie.io
BALLDONTLIE_KEY=
BALLDONTLIE_PER_MINUTE=4

# --- Cobrança (desligada enquanto o projeto for não comercial) ---
BILLING_ENABLED=false
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# --- Logs ---
LOG_LEVEL=info
